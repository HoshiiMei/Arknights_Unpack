<Window x:Class="ArkBrowser.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArkBrowser.UI"
        mc:Ignorable="d"
        Title="ArkBrowser" Height="720" Width="1200">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button x:Name="OpenButton"
                    Content="打开 AB..."
                    Padding="12,6"
                    Click="OpenButton_Click"/>
            <TextBox x:Name="PathTextBox"
                     Margin="10,0,0,0"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,10,0,10"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Entries">
                <DataGrid x:Name="EntriesGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="EntriesGrid_SelectionChanged"/>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Objects"
                      Margin="10,0,0,0">
                <DataGrid x:Name="ObjectsGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="ObjectsGrid_SelectionChanged"/>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3"
                  Header="对象详情"
                  Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DetailTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="96"
                         MaxHeight="180"/>
                <Border Grid.Column="1"
                        Margin="10,0,0,0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Background="WhiteSmoke"
                        Width="180"
                        Height="180">
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"/>
                </Border>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="FooterText"
                   Grid.Row="4"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>