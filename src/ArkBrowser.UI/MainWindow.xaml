<Window x:Class="ArkBrowser.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArkBrowser.UI"
        mc:Ignorable="d"
        Title="ArkBrowser" Height="720" Width="1200">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button x:Name="OpenButton"
                    Content="打开 AB..."
                    Padding="12,6"
                    Click="OpenButton_Click"/>
            <Button x:Name="OpenDirectoryButton"
                    Content="打开目录..."
                    Padding="12,6"
                    Margin="10,0,0,0"
                    Click="OpenDirectoryButton_Click"/>
            <Button x:Name="ExportButton"
                    Content="导出选中..."
                    Padding="12,6"
                    Margin="10,0,0,0"
                    Click="ExportButton_Click"/>
            <TextBlock Text="通道:"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
            <ComboBox x:Name="ChannelViewCombo"
                      Width="110"
                      Margin="6,0,0,0"
                      SelectionChanged="ChannelViewCombo_SelectionChanged">
                <ComboBoxItem Content="RGB+A" Tag="Rgba"/>
                <ComboBoxItem Content="RGB" Tag="Rgb"/>
                <ComboBoxItem Content="Alpha" Tag="Alpha"/>
            </ComboBox>
            <TextBox x:Name="PathTextBox"
                     Margin="10,0,0,0"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,10,0,10">
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"/>
            <ProgressBar x:Name="ThumbnailProgress"
                         Height="16"
                         Margin="0,6,0,0"
                         Minimum="0"
                         Maximum="1"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="ThumbnailStatusText"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="资产树">
                <TreeView x:Name="AssetTree"
                          SelectedItemChanged="AssetTree_SelectedItemChanged"/>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Objects"
                      Margin="10,0,0,0">
                <DataGrid x:Name="ObjectsGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionChanged="ObjectsGrid_SelectionChanged"
                          MouseDoubleClick="ObjectsGrid_MouseDoubleClick"/>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3"
                  Header="对象详情"
                  Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DetailTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="96"
                         MaxHeight="180"/>
                <Border Grid.Column="1"
                        Margin="10,0,0,0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Width="180"
                        Height="180">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#F5F5F5" Geometry="M0,0 H16 V16 H0 Z"/>
                                    <GeometryDrawing Brush="#D0D0D0" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="PreviewImage"
                               Grid.Row="0"
                               Stretch="Uniform"/>
                        <Button x:Name="FullResButton"
                                Grid.Row="1"
                                Content="查看原图"
                                Margin="0,6,0,0"
                                Click="FullResButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="FooterText"
                   Grid.Row="4"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
